<% layout ("/layouts/boilerplate") %>


    <body>
        <div class="row mt-3">
            <div class="col-8 offset-2">
                <h3>Edit Your Listing</h3>
                <form method="POST" action="/listings/<%= listing.id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label><br>
                        <input value=" <%= listing.title %>" name="listing[title]" type="text" class="form-control"
                            id="title" minlength="5"required>
                            <div class="valid-feedback">
                                Correct
                            </div>
                            <div class="invalid-feedback">
                              Please enter valid title.
                            </div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label><br>
                        <textarea name="listing[description]" class="form-control"minlength="5"
                            required><%=listing.description%></textarea>
                            <div class="valid-feedback">
                                Looks good
                            </div>
                            <div class="invalid-feedback">
                                Please enter a short description.
                            </div>
                    </div>

                    <div class="mb-3">
                        Original Listing Image <br>
                        <img src="<%= originalImageUrl %>" class="img-fluid" style="width: 250px;"/>
                    </div>


                    <div class="mb-3">
                        <label for="image" class="form-label">Upload New Image</label><br>
                        <input  name="listing[image]" type="file"
                            class="form-control" id="image"  />
                    </div>

                    <div class="row">
                        <div class="mb-3 col-4">
                            <label for="price" class="form-label">Price</label><br>
                            <input value="<%= listing.price %>" name="listing[price]" type="number" class="form-control"
                                id="price" min="1" required>
                                    <div class="valid-feedback">
                                Correct
                            </div>
                            <div class="invalid-feedback">
                                Price should be valid.
                            </div>
                        </div>

                        <div class="mb-3 col-8">
                            <label for="country" class="form-label">Country</label><br>
                            <input value="<%= listing.country %>" name="listing[country]" type="text"
                                class="form-control" id="country" minlength="5"required>
                                <div class="valid-feedback">
                                Correct
                            </div>
                            <div class="invalid-feedback">
                                country name should be valid.
                            </div>
                        </div>
                        
                    </div>


                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label><br>
                        <input value="<%= listing.location %>" name="listing[location]" type="text" class="form-control"
                            id="location" minlength="5"required>
                            <div class="valid-feedback">
                                Correct
                            </div>
                            <div class="invalid-feedback">
                                Location name should be valid.
                            </div>
                    </div>

                    <button class="btn btn-dark add-btn btn-clr">Update</button>
                    <br><br>
                </form>
            </div>
        </div>
 <script src="/js/script.js"></script>
    </body>